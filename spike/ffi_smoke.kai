extern "C" fn kai_tui_raw_enable() : Int / Ffi
extern "C" fn kai_tui_raw_disable() : Int / Ffi
extern "C" fn kai_tui_read_key() : Int / Ffi

fn main() : Unit / Ffi + Stdout = {
  let _ = kai_tui_raw_enable()
  Stdout.print("raw on; press a key...")
  let k = kai_tui_read_key()
  let _ = kai_tui_raw_disable()
  Stdout.print("you pressed byte: #{k}")
}
