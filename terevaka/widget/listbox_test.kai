# Tests for the listbox widget — the scrolling viewport, which is the
# part with real arithmetic: the window follows the cursor and clamps
# at both ends, and the rendered block is always height + 1 lines
# (the rows plus the scroll hint).

import terevaka.widget.listbox
import terevaka.ui
import terevaka.term

fn down_n(l: listbox.List, n: Int) : listbox.List =
  if n <= 0 { l } else { down_n(listbox.update(l, Down), n - 1) }

test "listbox — the viewport follows the cursor down" {
  let l = listbox.init(["a", "b", "c", "d", "e"], 3)
  assert listbox.selected_label(l) == "a"

  # inside the window: the cursor moves, the window does not
  assert listbox.selected_label(down_n(l, 2)) == "c"

  # past the window: it scrolls to keep the cursor visible
  assert listbox.selected_label(down_n(l, 3)) == "d"
  assert listbox.selected_label(down_n(l, 4)) == "e"
}

test "listbox — the cursor wraps around the ends" {
  let l = listbox.init(["a", "b", "c"], 2)
  assert listbox.selected_label(down_n(l, 3)) == "a"  # full cycle
  assert listbox.selected_label(listbox.update(l, Up)) == "c"
}

test "listbox — a window shorter than the list renders height+1 lines" {
  let l = listbox.init(["a", "b", "c", "d", "e"], 3)
  assert list.length(ui.render(listbox.view(l))) == 4  # 3 rows + hint
}

test "listbox — a window longer than the list renders what exists" {
  let l = listbox.init(["a", "b"], 5)
  assert list.length(ui.render(listbox.view(l))) == 3  # 2 rows + hint
}

test "listbox — an empty list renders just the hint" {
  let l = listbox.init([], 3)
  assert listbox.selected_label(l) == ""
  assert list.length(ui.render(listbox.view(l))) == 1
}

test "listbox — an empty list keeps the cursor on a real index" {
  let l = listbox.init([], 3)
  assert listbox.selected(listbox.update(l, Up)) == 0
  assert listbox.selected(listbox.update(l, Down)) == 0
  assert listbox.selected_label(listbox.update(l, Up)) == ""
}

# The scroll hint is the last rendered line: arrows for what lies above
# and below the window, then the visible range.
fn hint(l: listbox.List) : String {
  let lines = ui.render(listbox.view(l))
  list.nth(lines, list.length(lines) - 1) ?? ""
}

fn hint_of(up: String, down: String, range: String) : String =
  term.fg(245, "  #{up} #{down}  #{range}")

test "listbox — the window scrolls only once the cursor leaves it" {
  let l = listbox.init(["a", "b", "c", "d", "e"], 3)
  assert hint(l) == hint_of(" ", "▼", "1-3/5")
  assert hint(down_n(l, 2)) == hint_of(" ", "▼", "1-3/5")  # last visible row
  assert hint(down_n(l, 3)) == hint_of("▲", "▼", "2-4/5")  # one past it
  assert hint(down_n(l, 4)) == hint_of("▲", " ", "3-5/5")  # bottom: nothing below
}

test "listbox — wrapping to either end brings the window with it" {
  let l = listbox.init(["a", "b", "c", "d", "e"], 3)
  assert hint(down_n(l, 5)) == hint_of(" ", "▼", "1-3/5")  # bottom wraps to top
  assert hint(listbox.update(l, Up)) == hint_of("▲", " ", "3-5/5")
}

test "listbox — the cursor row is highlighted at its absolute index" {
  let rows = ui.render(listbox.view(down_n(listbox.init(["a", "b", "c", "d", "e"], 3), 3)))
  assert list.take(rows, 3)
    == [
      " " ++ term.dim(" b "),
      " " ++ term.dim(" c "),
      term.fg(220, "▸") ++ term.bg(44, term.fg(236, " d "))
    ]
}

test "listbox — k and j mirror Up and Down" {
  let l = listbox.init(["a", "b", "c"], 2)
  assert listbox.selected(listbox.update(l, Printable('j'))) == 1
  assert listbox.selected(listbox.update(l, Printable('k'))) == 2  # wraps to the last
  assert listbox.selected(listbox.update(l, Printable('x'))) == 0
}
