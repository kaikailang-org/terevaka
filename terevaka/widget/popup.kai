# terevaka/widget/popup.kai — a modal popup overlay.
#
# Imported as `import terevaka.widget.popup`. A popup is a titled,
# bordered box meant to be drawn ON TOP of the rest of the UI. It
# holds a title and body lines; `update` reports whether a key
# dismissed it (Enter/Esc/q close). The app composites it as an
# overlay (the runtime paints the base UI, then the popup at an
# offset).

import terevaka.ui
import terevaka.term

#[doc("A titled, bordered box meant to be drawn on top of the rest of the UI.")]
pub type Popup = { title: String, lines: [String], width: Int }

#[doc("A popup with a title and body lines, at the default width.")]
pub fn make(title: String, lines: [String]) : Popup =
  Popup { title: title, lines: lines, width: 34 }

#[doc("Whether `k` dismisses the popup: Enter, Esc or q.")]
pub fn dismissed(k: term.Key) : Bool =
  match k {
    Enter        -> true
    Esc          -> true
    Printable(c) -> c == 'q'
    _            -> false
  }

#[doc("""
Frame the popup in a magenta-bordered box.

Body lines are passed through as-is, so a caller that wants them
coloured colours them itself.

Draw the result as an overlay (`app.run_overlay` or
`app.paint_with_overlay`) — rendering it inline just puts a box in the
flow.
""")]
pub fn view(p: Popup) : Ui =
  ui.box_color(212, p.width, p.title, ui.col(p.lines | (l) => ui.text(l)))
