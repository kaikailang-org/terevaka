# Tests for the board widget — the card-moving operations, which are
# the reason the board exists (they cross two lists, so no leaf widget
# can express them) and the ones that do the most index arithmetic.

import terevaka.widget.board
import terevaka.term

fn fixture() : board.Board = board.init(
  [
    board.column("todo", 75, [
      board.card("A-1", Feature, "one"),
      board.card("A-2", Bug, "two")
    ]),
    board.column("doing", 83, [board.card("B-1", Chore, "three")])
  ],
  20,
  0
)

fn ref_of(c: Option[board.Card]) : String = match c {
  Some(card) -> card.ref
  None -> "(none)"
}

test "board — the cursor starts on the first card of the first column" {
  let b = fixture()
  assert board.active_column(b) == 0
  assert ref_of(board.selected_card(b)) == "A-1"
}

test "board — moving a card right carries the cursor with it" {
  let moved = board.move_card_right(fixture())
  assert board.active_column(moved) == 1  # follow the card
  assert ref_of(board.selected_card(moved)) == "A-1"

  # and it is gone from the source column
  let back = board.update(moved, Left)
  assert ref_of(board.selected_card(back)) == "A-2"
}

test "board — reordering swaps within the column" {
  let b = board.move_card_down(fixture())
  assert ref_of(board.selected_card(b)) == "A-1"  # cursor follows the card
  assert ref_of(board.selected_card(board.update(b, Up))) == "A-2"
}

test "board — reordering past an end is a no-op" {
  let b = fixture()
  assert ref_of(board.selected_card(board.move_card_up(b))) == "A-1"
}

test "board — adding and removing keeps the cursor in range" {
  let added = board.add_card(fixture(), "A-3", "three")
  assert ref_of(board.selected_card(added)) == "A-3"

  let emptied = board.remove_selected(board.remove_selected(board.remove_selected(added)))
  assert ref_of(board.selected_card(emptied)) == "(none)"

  # removing from an empty column does not fall over
  assert ref_of(board.selected_card(board.remove_selected(emptied))) == "(none)"
}

test "board — navigation wraps across columns" {
  let b = fixture()
  assert board.active_column(board.update(b, Left)) == 1  # wraps to last
  assert board.active_column(board.update(b, Right)) == 1
  assert board.active_column(board.update(board.update(b, Right), Right)) == 0
}

test "board — moving the last card of a column leaves the cursor on a real card" {
  let b = board.update(fixture(), Down)  # cursor on A-2, the last of "todo"
  let back = board.update(board.move_card_right(b), Left)
  assert ref_of(board.selected_card(back)) == "A-1"
}

test "board — the cursor moves within a column and wraps" {
  let b = fixture()
  assert ref_of(board.selected_card(board.update(b, Down))) == "A-2"
  assert ref_of(board.selected_card(board.update(b, Up))) == "A-2"  # wraps to the last
  assert ref_of(board.selected_card(board.update(board.update(b, Down), Down))) == "A-1"
}

test "board — reordering stops at both ends of the column" {
  let last = board.update(fixture(), Down)  # A-2, at the bottom
  let up = board.move_card_up(last)
  assert ref_of(board.selected_card(up)) == "A-2"
  assert ref_of(board.selected_card(board.update(up, Down))) == "A-1"

  let stuck = board.move_card_down(last)
  assert ref_of(board.selected_card(stuck)) == "A-2"
  assert ref_of(board.selected_card(board.update(stuck, Up))) == "A-1"
}

test "board — removing the last card moves the cursor up to the new last" {
  let added = board.add_card(fixture(), "A-3", "three")
  assert ref_of(board.selected_card(board.remove_selected(added))) == "A-2"
}

test "board — a card cannot move off a single-column board" {
  let b = board.init([board.column("only", 75, [board.card("A-1", Task, "one")])], 20, 0)
  let moved = board.move_card_right(b)
  assert board.active_column(moved) == 0
  assert ref_of(board.selected_card(moved)) == "A-1"
}

# Three cards, so a reorder cannot be mistaken for the cursor wrapping.
test "board — reordering moves the card one place and the cursor with it" {
  let mid = board.update(board.add_card(fixture(), "A-3", "three"), Up)  # on A-2, in the middle
  let up = board.move_card_up(mid)  # A-2, A-1, A-3
  assert ref_of(board.selected_card(up)) == "A-2"
  assert ref_of(board.selected_card(board.update(up, Down))) == "A-1"

  let down = board.move_card_down(mid)  # A-1, A-3, A-2
  assert ref_of(board.selected_card(down)) == "A-2"
  assert ref_of(board.selected_card(board.update(down, Up))) == "A-3"
}
