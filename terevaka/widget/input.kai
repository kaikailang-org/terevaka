# terevaka/widget/input.kai — a single-line text input widget.
#
# Imported as `import terevaka.widget.input`. Holds the typed text
# and whether it is focused (drawing a cursor). `update` appends
# printable keys, deletes on Backspace, and reports done/cancel on
# Enter/Esc via the returned Outcome so the app can react.

import terevaka.ui
import terevaka.term
import core.string

#[doc("A single-line text field: its contents and whether it has focus.")]
pub type Input = { text: String, focused: Bool }

#[doc("""
What a key did to the field, so the app can route the result.

`Editing` carries the field back for the next key; `Done` carries the
final text (Enter); `Cancelled` means Esc — the app keeps the previous
value.
""")]
pub type Outcome = Editing(Input) | Done(String) | Cancelled

#[doc("An empty, unfocused field.")]
pub fn init() : Input = Input { text: "", focused: false }
#[doc("An unfocused field pre-filled with `s`.")]
pub fn with_text(s: String) : Input = Input { text: s, focused: false }
#[doc("Give the field focus — it renders a cursor block and takes keys.")]
pub fn focus(i: Input) : Input = Input { ...i, focused: true }
#[doc("Remove focus, keeping the text.")]
pub fn blur(i: Input) : Input = Input { ...i, focused: false }
#[doc("The current text.")]
pub fn value(i: Input) : String = i.text

#[doc("Apply a key: printable chars append, Backspace deletes, Enter commits, Esc cancels.")]
pub fn update(i: Input, k: term.Key) : Outcome =
  match k {
    Printable(c) -> Editing(Input { ...i, text: i.text ++ "#{c}" })
    Backspace    -> Editing(Input { ...i, text: drop_last(i.text) })
    Enter        -> Done(i.text)
    Esc          -> Cancelled
    _            -> Editing(i)
  }

#[doc("Render as `label ⟨ text ⟩`, with a cursor block when focused.")]
pub fn view(lbl: String, i: Input) : Ui = {
  let shown = if i.text == "" { term.dim("(empty)") } else { i.text }
  let cursor = if i.focused { term.fg(83, "▏") } else { "" }
  ui.row([
    ui.muted(lbl),
    ui.label(75, "⟨"),
    ui.text(" " ++ shown ++ cursor ++ " "),
    ui.label(75, "⟩")
  ])
}

# ---- local helpers ----
# Backspace deletes a GLYPH, not a byte. `string.length` and
# `string.slice` are byte-indexed, so slicing one off the end splits a
# multibyte codepoint and leaves mojibake behind; `string.chars`
# iterates real codepoints, so dropping the last of those is the edit
# the user asked for.
fn drop_last(s: String) : String = {
  let cs = string.chars(s)
  let n = list.length(cs)
  if n == 0 { "" } else { string.from_chars(list.take(cs, n - 1)) }
}
