# terevaka/widget/menu.kai — a navigable list widget.
#
# Imported as `import terevaka.widget.menu`. A menu is the canonical
# stateful-but-simple widget: it holds a list of item labels and a
# cursor index. `update` moves the cursor on Up/Down (and j/k);
# `view` renders the items with the selected one highlighted.
#
# This is a "Level 1.5" widget in the design's terms: it has state
# (the cursor) but the state is a plain value threaded by the app,
# not a fiber — the actor form is still ahead. The shape (State +
# update + view) is exactly what each widget exposes.

import terevaka.ui
import terevaka.term
import terevaka.nav

#[doc("A list of item labels plus the cursor position.")]
pub type Menu = { items: [String], cursor: Int }

#[doc("A menu over `items`, cursor on the first.")]
pub fn init(items: [String]) : Menu = Menu { items: items, cursor: 0 }

#[doc("How many items the menu holds.")]
pub fn count(m: Menu) : Int = list.length(m.items)

#[doc("The selected item's label, or the empty string when there are none.")]
pub fn selected_label(m: Menu) : String = list.nth(m.items, m.cursor).unwrap_or("")

#[doc("The cursor index.")]
pub fn selected(m: Menu) : Int = m.cursor

#[doc("Move the cursor with Up/Down or k/j, wrapping at both ends. Other keys are no-ops.")]
pub fn update(m: Menu, k: term.Key) : Menu =
  match k {
    Up           -> with_cursor(m, nav.wrap(m.cursor - 1, count(m)))
    Down         -> with_cursor(m, nav.wrap(m.cursor + 1, count(m)))
    Printable(c) -> match c {
                      'k' -> with_cursor(m, nav.wrap(m.cursor - 1, count(m)))
                      'j' -> with_cursor(m, nav.wrap(m.cursor + 1, count(m)))
                      _   -> m
                    }
    _            -> m
  }

fn with_cursor(m: Menu, c: Int) : Menu = Menu { ...m, cursor: c }

#[doc("Render one row per item, the selected one carrying the highlight bar.")]
pub fn view(m: Menu) : Ui = {
  let w = item_width(m.items)
  ui.col(list.map_indexed(m.items, (i, x) => item_row(x, i == m.cursor, w)))
}

fn item_row(lbl: String, sel: Bool, w: Int) : Ui =
  if sel {
    ui.row([ ui.label(220, "▸"), Text(Selected(44), " " ++ ui.fit(lbl, w) ++ " ") ])
  } else {
    ui.row([ ui.text(" "), Text(Dim, " " ++ ui.fit(lbl, w) ++ " ") ])
  }

# widest item, for a uniform highlight bar (0 when there are none)
fn item_width(items: [String]) : Int =
  list.max(items | (s) => ui.visible_len(s)).unwrap_or(0)
