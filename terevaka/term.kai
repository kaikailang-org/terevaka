# terevaka/term.kai — the terminal layer.
#
# Imported as `import terevaka.term`. Wraps the C shim
# (c/terevaka_term.{c,h}) plus the ANSI escape primitives every
# higher layer (ui, widgets, app) builds on. This is the only module
# that carries `Ffi` in its row — everything above it stays Ffi-free
# until it actually touches the terminal.
#
# Surface:
#   - raw mode lifecycle: raw_enable / raw_disable
#   - input: poll_key(ms) -> Key (non-blocking, assembles arrows)
#   - output: write(s) (no newline), and the ANSI builders below
#   - geometry: rows() / cols()

# ---- FFI to the shim ----
extern "C" fn kai_tvk_raw_enable() : Int / Ffi
extern "C" fn kai_tvk_raw_disable() : Int / Ffi
extern "C" fn kai_tvk_poll_key(timeout_ms: Int) : Int / Ffi
extern "C" fn kai_tvk_write(s: String) : Int / Ffi
extern "C" fn kai_tvk_term_rows() : Int / Ffi
extern "C" fn kai_tvk_term_cols() : Int / Ffi

# ---- Lifecycle ----
#[doc("""
Put the terminal into raw mode: no line buffering, no echo, so keys
arrive one byte at a time. Pair every call with `raw_disable`, or the
shell is left unusable after the program exits.

Returns whether raw mode actually came on. It does not when stdin is
not a terminal — a pipe, a redirect, a CI job — and a caller that
ignores that goes on to drive a UI over a descriptor that will never
deliver a keystroke. `raw_disable` is safe either way: it restores
nothing when there was nothing to save.
""")]
pub fn raw_enable() : Bool / Ffi = kai_tvk_raw_enable() == 0

#[doc("Restore the terminal settings saved by `raw_enable`.")]
pub fn raw_disable() : Unit / Ffi = { let _ = kai_tvk_raw_disable(); () }

#[doc("The terminal height in rows, from the shim's window-size query.")]
pub fn rows() : Int / Ffi = kai_tvk_term_rows()

#[doc("The terminal width in columns, from the shim's window-size query.")]
pub fn cols() : Int / Ffi = kai_tvk_term_cols()

# ---- Keys ----
#[doc("""
The byte stream from the terminal, assembled into logical keys.

Two of these are not keystrokes. `Tick` is returned when a poll times
out with no input, so an app loop can refresh — and advance a clock —
while idle. `Eof` means stdin is closed and will never yield again: it
MUST end the loop, because a closed descriptor polls ready forever and
a loop that treats it as an unrecognised key spins at full speed with
no way out. `Unknown` is the recoverable case — a sequence this layer
does not decode, or a read error — and is safe to ignore.
""")]
pub type Key =
  Up | Down | Left | Right
  | Enter | Backspace | Esc | Tab
  | Printable(Char)
  | Tick
  | Eof
  | Unknown

#[doc("""
Poll for one key, waiting at most `ms` milliseconds.

Returns `Tick` when the wait elapses with no input, which is what lets
an app loop stay responsive while idle, and `Eof` when stdin is closed
— a caller that keeps polling after `Eof` spins on a dead descriptor.
Arrow keys arrive as the 3-byte ESC '[' 'A'..'D' sequence and are
assembled here, so a caller sees `Up` rather than three bytes.
""")]
pub fn poll_key(ms: Int) : Key / Ffi = match kai_tvk_poll_key(ms) {
  -1  -> Tick
  -2  -> Eof
  27  -> escape_seq()
  13  -> Enter
  10  -> Enter
  9   -> Tab
  127 -> Backspace
  8   -> Backspace
  b if b < 0   -> Unknown          # -3: read error, recoverable
  b if b >= 32 -> Printable(int_to_char(b))
  _   -> Unknown
}

# ESC arrived: it either opens an arrow sequence ('[' then 'A'..'D')
# or stands alone as the Esc key. The follow-up bytes are already in
# the buffer, so a short poll suffices.
fn escape_seq() : Key / Ffi =
  if kai_tvk_poll_key(20) == 91 {
    match kai_tvk_poll_key(20) {
      65 -> Up
      66 -> Down
      67 -> Right
      68 -> Left
      _  -> Unknown
    }
  } else { Esc }

# ---- Raw output ----
#[doc("""
Write `s` to the terminal with no trailing newline.

The no-newline part is the point: a TUI positions text with `goto`,
and a stray newline would scroll the screen out from under the frame.
""")]
pub fn write(s: String) : Unit / Ffi = { let _ = kai_tvk_write(s); () }

# ---- ANSI escape builders (pure String functions; no Ffi) ----
#[doc("The ESC character (byte 27) that opens every ANSI sequence.")]
pub fn esc() : String = "#{int_to_char(27)}"

#[doc("Erase the whole screen and home the cursor.")]
pub fn clear() : String = "#{esc()}[2J#{esc()}[H"

#[doc("""
Move the cursor to the top-left WITHOUT erasing the screen.

This is the in-place repaint path: overwriting every cell with the new
frame avoids the whole-screen erase (`clear`) that a terminal shows as
a flash on each repaint. Pair it with `clear_eol` per line, so a
shorter new line erases the tail of the old one.
""")]
pub fn home() : String = "#{esc()}[H"

#[doc("Erase from the cursor to the end of the current line.")]
pub fn clear_eol() : String = "#{esc()}[K"

#[doc("Position the cursor. Rows and columns are 1-based, as ANSI counts them.")]
pub fn goto(row: Int, col: Int) : String = "#{esc()}[#{row};#{col}H"

#[doc("Hide the cursor — a TUI draws its own, so the real one only flickers.")]
pub fn hide_cursor() : String = "#{esc()}[?25l"

#[doc("Show the cursor again. Always pair with `hide_cursor` before exit.")]
pub fn show_cursor() : String = "#{esc()}[?25h"

#[doc("""
Wrap `s` in a 256-color foreground, resetting after.

Composing colour with an attribute is fine — each wrapper resets only
itself — but note that the reset ends ALL attributes, so the outer
wrapper must be applied last.
""")]
pub fn fg(code: Int, s: String) : String = "#{esc()}[38;5;#{code}m#{s}#{esc()}[0m"

#[doc("Wrap `s` in a 256-color background, resetting after.")]
pub fn bg(code: Int, s: String) : String = "#{esc()}[48;5;#{code}m#{s}#{esc()}[0m"

#[doc("Render `s` bold.")]
pub fn bold(s: String) : String = "#{esc()}[1m#{s}#{esc()}[0m"

#[doc("Render `s` dim — the framework's convention for secondary text.")]
pub fn dim(s: String) : String = "#{esc()}[2m#{s}#{esc()}[0m"

#[doc("Swap foreground and background for `s`.")]
pub fn invert(s: String) : String = "#{esc()}[7m#{s}#{esc()}[0m"

# ---- Asking the terminal a question ----
#[doc("""
The body of a terminated reply: `raw` without the first of
`terminators` it ends with, or `None` when it ends with none of them.

Pure, so a caller assembling bytes by other means can share the same
rule `probe` reads by. Empty terminators are skipped: one would match
every string and swallow the whole reply.
""")]
pub fn reply_body(raw: String, terminators: [String]) : Option[String] =
  match terminators {
    []           -> None
    [t, ...rest] ->
      if t == "" { reply_body(raw, rest) }
      else {
        match string.drop_suffix(raw, t) {
          Some(body) -> Some(body)
          None       -> reply_body(raw, rest)
        }
      }
  }

#[doc("""
Ask the terminal something and read what it answers back.

Writes `request`, then reads until the reply ends with one of
`terminators` and returns the body without it. `None` means the
terminal did not answer — which is the answer a capability probe is
after: an emulator that does not speak the protocol stays silent.

Call this BEFORE `app.run`, never during it. The transaction owns raw
mode for its own duration and restores the terminal on the way out, so
the runtime then does its own clean enable. Two reasons it cannot share
the loop: `poll_key` routes the ESC every reply opens to the arrow
decoder, which eats it, and enabling raw mode twice makes the raw state
the one `raw_disable` restores to.

`first_ms` budgets the terminal's round trip. The rest of the reply
arrives in the same burst and is read on a short fixed timeout, so no
clock is needed to bound the whole exchange. A reply is read whole or
not at all — anything past 256 bytes is treated as noise rather than an
answer, and a partial one is discarded by the flush on the way out
rather than leaking into the app as phantom keystrokes.

```kai
# does this terminal speak the kitty graphics protocol?
let esc = term.esc()
let supported = term.probe(
  "#{esc}_Gi=31,s=1,v=1,a=q,t=d,f=24;AAAA#{esc}\\\\",
  ["#{esc}\\\\"],
  120
) != None
```
""")]
pub fn probe(request: String, terminators: [String], first_ms: Int) : Option[String] / Ffi =
  # A failed enable means stdin is not a terminal, so nothing can
  # answer; the terminal is untouched and there is nothing to restore.
  if kai_tvk_raw_enable() != 0 { None }
  else {
    let _ = kai_tvk_write(request)
    let answer = read_reply(terminators, first_ms, [])
    let _ = kai_tvk_raw_disable()
    answer
  }

# Read one byte at a time, testing the reply after each. The first read
# waits `ms` for the round trip; the rest arrive together, so they wait
# the same short beat `escape_seq` gives a pending arrow sequence.
fn read_reply(terminators: [String], ms: Int, acc_rev: [Byte]) : Option[String] / Ffi =
  if list.length(acc_rev) >= reply_cap() { None }
  else {
    match kai_tvk_poll_key(ms) {
      # timeout, end of input or a read error: no answer is coming
      b if b < 0 -> None
      b -> match int_to_byte(b) {
        Err(_)   -> None
        Ok(byte) -> {
          let next = [byte, ...acc_rev]
          let raw  = string.from_bytes(list.reverse(next))
          match reply_body(raw, terminators) {
            Some(body) -> Some(body)
            None       -> read_reply(terminators, follow_ms(), next)
          }
        }
      }
    }
  }

# How long to wait for each byte after the first. The reply arrives as
# one burst, so this bounds the tail without a clock.
fn follow_ms() : Int = 20

# Past this many bytes the stream is noise, not a reply to the question
# we asked. Bounds the read when a terminator never arrives but bytes
# keep coming.
fn reply_cap() : Int = 256
