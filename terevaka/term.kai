# terevaka/term.kai — the terminal layer.
#
# Imported as `import terevaka.term`. Wraps the C shim
# (c/terevaka_term.{c,h}) plus the ANSI escape primitives every
# higher layer (ui, widgets, app) builds on. This is the only module
# that carries `Ffi` in its row — everything above it stays Ffi-free
# until it actually touches the terminal.
#
# Surface:
#   - raw mode lifecycle: raw_enable / raw_disable
#   - input: poll_key(ms) -> Key (non-blocking, assembles arrows)
#   - output: write(s) (no newline), and the ANSI builders below
#   - geometry: rows() / cols()

# ---- FFI to the shim ----
extern "C" fn kai_tvk_raw_enable() : Int / Ffi
extern "C" fn kai_tvk_raw_disable() : Int / Ffi
extern "C" fn kai_tvk_poll_key(timeout_ms: Int) : Int / Ffi
extern "C" fn kai_tvk_write(s: String) : Int / Ffi
extern "C" fn kai_tvk_term_rows() : Int / Ffi
extern "C" fn kai_tvk_term_cols() : Int / Ffi

# ---- Lifecycle ----
#[doc("""
Put the terminal into raw mode: no line buffering, no echo, so keys
arrive one byte at a time. Pair every call with `raw_disable`, or the
shell is left unusable after the program exits.
""")]
pub fn raw_enable() : Unit / Ffi = { let _ = kai_tvk_raw_enable(); () }

#[doc("Restore the terminal settings saved by `raw_enable`.")]
pub fn raw_disable() : Unit / Ffi = { let _ = kai_tvk_raw_disable(); () }

#[doc("The terminal height in rows, from the shim's window-size query.")]
pub fn rows() : Int / Ffi = kai_tvk_term_rows()

#[doc("The terminal width in columns, from the shim's window-size query.")]
pub fn cols() : Int / Ffi = kai_tvk_term_cols()

# ---- Keys ----
#[doc("""
The byte stream from the terminal, assembled into logical keys.

`Tick` is synthetic: it is returned when a poll times out with no
input, so an app loop can refresh — and advance a clock — while idle.
`Unknown` covers both an unrecognised sequence and a read error.
""")]
pub type Key =
  Up | Down | Left | Right
  | Enter | Backspace | Esc | Tab
  | Printable(Char)
  | Tick
  | Unknown

#[doc("""
Poll for one key, waiting at most `ms` milliseconds.

Returns `Tick` when the wait elapses with no input, which is what lets
an app loop stay responsive while idle. Arrow keys arrive as the
3-byte ESC '[' 'A'..'D' sequence and are assembled here, so a caller
sees `Up` rather than three bytes.
""")]
pub fn poll_key(ms: Int) : Key / Ffi = match kai_tvk_poll_key(ms) {
  -1  -> Tick
  27  -> escape_seq()
  13  -> Enter
  10  -> Enter
  9   -> Tab
  127 -> Backspace
  8   -> Backspace
  b if b < 0   -> Unknown
  b if b >= 32 -> Printable(int_to_char(b))
  _   -> Unknown
}

# ESC arrived: it either opens an arrow sequence ('[' then 'A'..'D')
# or stands alone as the Esc key. The follow-up bytes are already in
# the buffer, so a short poll suffices.
fn escape_seq() : Key / Ffi =
  if kai_tvk_poll_key(20) == 91 {
    match kai_tvk_poll_key(20) {
      65 -> Up
      66 -> Down
      67 -> Right
      68 -> Left
      _  -> Unknown
    }
  } else { Esc }

# ---- Raw output ----
#[doc("""
Write `s` to the terminal with no trailing newline.

The no-newline part is the point: a TUI positions text with `goto`,
and a stray newline would scroll the screen out from under the frame.
""")]
pub fn write(s: String) : Unit / Ffi = { let _ = kai_tvk_write(s); () }

# ---- ANSI escape builders (pure String functions; no Ffi) ----
#[doc("The ESC character (byte 27) that opens every ANSI sequence.")]
pub fn esc() : String = "#{int_to_char(27)}"

#[doc("Erase the whole screen and home the cursor.")]
pub fn clear() : String = "#{esc()}[2J#{esc()}[H"

#[doc("""
Move the cursor to the top-left WITHOUT erasing the screen.

This is the in-place repaint path: overwriting every cell with the new
frame avoids the whole-screen erase (`clear`) that a terminal shows as
a flash on each repaint. Pair it with `clear_eol` per line, so a
shorter new line erases the tail of the old one.
""")]
pub fn home() : String = "#{esc()}[H"

#[doc("Erase from the cursor to the end of the current line.")]
pub fn clear_eol() : String = "#{esc()}[K"

#[doc("Position the cursor. Rows and columns are 1-based, as ANSI counts them.")]
pub fn goto(row: Int, col: Int) : String = "#{esc()}[#{row};#{col}H"

#[doc("Hide the cursor — a TUI draws its own, so the real one only flickers.")]
pub fn hide_cursor() : String = "#{esc()}[?25l"

#[doc("Show the cursor again. Always pair with `hide_cursor` before exit.")]
pub fn show_cursor() : String = "#{esc()}[?25h"

#[doc("""
Wrap `s` in a 256-color foreground, resetting after.

Composing colour with an attribute is fine — each wrapper resets only
itself — but note that the reset ends ALL attributes, so the outer
wrapper must be applied last.
""")]
pub fn fg(code: Int, s: String) : String = "#{esc()}[38;5;#{code}m#{s}#{esc()}[0m"

#[doc("Wrap `s` in a 256-color background, resetting after.")]
pub fn bg(code: Int, s: String) : String = "#{esc()}[48;5;#{code}m#{s}#{esc()}[0m"

#[doc("Render `s` bold.")]
pub fn bold(s: String) : String = "#{esc()}[1m#{s}#{esc()}[0m"

#[doc("Render `s` dim — the framework's convention for secondary text.")]
pub fn dim(s: String) : String = "#{esc()}[2m#{s}#{esc()}[0m"

#[doc("Swap foreground and background for `s`.")]
pub fn invert(s: String) : String = "#{esc()}[7m#{s}#{esc()}[0m"
