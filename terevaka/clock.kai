# terevaka/clock.kai — a tiny clock helper.
#
# Imported as `import terevaka.clock`. Formats the current time as
# "HH:MM:SS UTC" from the Clock effect. (No localtime in stdlib yet;
# UTC from epoch seconds via integer arithmetic.)

import time

#[doc("""
The current UTC time as "HH:MM:SS UTC".

Derived from epoch seconds by integer arithmetic, since the stdlib has
no localtime — the trailing "UTC" is part of the string so a reader is
never misled about the zone.
""")]
pub fn hhmmss_utc() : String / Clock = {
  let secs = time.now().secs
  let day  = secs % 86400
  let h    = day / 3600
  let m    = (day % 3600) / 60
  let s    = day % 60
  "#{pad2(h)}:#{pad2(m)}:#{pad2(s)} UTC"
}

fn pad2(n: Int) : String = if n < 10 { "0#{n}" } else { "#{n}" }
