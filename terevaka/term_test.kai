# Tests for the pure half of the terminal layer: the ANSI builders and
# the reply rule `probe` reads by.
#
# The Ffi half is not covered here. raw_enable/raw_disable, rows/cols,
# poll_key and `probe` itself all need a real terminal — the path taken
# when there is none is covered instead by the `test-notty` target in
# the Makefile, which runs a built app with its stdin redirected.
# `probe` is split so the part that decides when a reply is complete is
# pure, and that part is what these cover.

import terevaka.term
import terevaka.ui
import core.string

test "term — escape sequences occupy no display columns" {
  assert ui.visible_len(term.fg(31, "red")) == 3
  assert ui.visible_len(term.bg(31, "red")) == 3
  assert ui.visible_len(term.bold("red")) == 3
  assert ui.visible_len(term.dim("red")) == 3
  assert ui.visible_len(term.invert("red")) == 3
}

test "term — wrappers nest without losing the payload" {
  assert ui.visible_len(term.bold(term.fg(31, "red"))) == 3
  assert ui.visible_len(term.bg(52, term.bold(term.fg(31, "red")))) == 3
}

test "term — a wrapper leaves the content itself untouched" {
  # the payload survives verbatim between the opening code and the reset
  assert string.index_of(term.fg(31, "hello"), "hello") != None
  assert string.index_of(term.goto(3, 7), "3;7H") != None
}

test "term — esc is one character, the sequences build on it" {
  assert list.length(string.chars(term.esc())) == 1
  assert string.starts_with(term.clear(), term.esc())
  assert string.starts_with(term.home(), term.esc())
  assert string.starts_with(term.clear_eol(), term.esc())
  assert string.starts_with(term.hide_cursor(), term.esc())
  assert string.starts_with(term.show_cursor(), term.esc())
}

# ---- reply_body: the rule `probe` stops reading on ----

test "reply_body — a reply ending in a terminator gives up its body" {
  let st = "#{term.esc()}\\"
  assert term.reply_body("#{term.esc()}_Gi=31;OK#{st}", [st]) == Some("#{term.esc()}_Gi=31;OK")
  assert term.reply_body("body#{st}", [st]) == Some("body")
}

test "reply_body — an unterminated reply is not a reply yet" {
  let st = "#{term.esc()}\\"
  assert term.reply_body("#{term.esc()}_Gi=31;OK", [st]) == None
  assert term.reply_body("", [st]) == None
  # a prefix of the terminator is not the terminator
  assert term.reply_body("body#{term.esc()}", [st]) == None
}

test "reply_body — the first matching terminator wins" {
  # OSC 11 closes with ST on some terminals and BEL on others, which is
  # why the caller passes a list rather than one string
  let st  = "#{term.esc()}\\"
  let bel = "#{int_to_char(7)}"
  assert term.reply_body("rgb:1111/2222/3333#{bel}", [st, bel]) == Some("rgb:1111/2222/3333")
  assert term.reply_body("rgb:1111/2222/3333#{st}", [st, bel]) == Some("rgb:1111/2222/3333")
  assert term.reply_body("rgb:1111/2222/3333", [st, bel]) == None
}

test "reply_body — no terminator can ever match" {
  # an empty terminator would match every string and swallow the reply,
  # so it is skipped rather than honoured
  assert term.reply_body("anything", []) == None
  assert term.reply_body("anything", [""]) == None
  assert term.reply_body("anything", ["", "thing"]) == Some("any")
}

test "reply_body — the terminator is stripped, not just detected" {
  let st   = "#{term.esc()}\\"
  let body = term.reply_body("payload#{st}", [st]).unwrap_or("")
  assert body == "payload"
  # no fragment of the terminator survives in the body
  assert string.index_of(body, term.esc()) == None
}
